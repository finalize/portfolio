---
/**
 * 上部バーの検索窓。全ページに出る。
 *
 * 素の `<form action="/" method="get">` なので、JavaScript が無くても
 * ホームへ `?q=...` を付けて飛ぶ。ホームだけがその `q` を読んで
 * `/api/ask` に問い合わせ、答えを描く（Answer.astro）。
 */
import { SITE } from '../consts';
---

<form class="searchbox" id="searchform" action="/" method="get" role="search">
  <svg
    class="searchbox__icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
  </svg>

  <label class="visually-hidden" for="q">
    {SITE.displayName} について知りたいことを入力する
  </label>
  <input
    class="searchbox__input"
    id="q"
    name="q"
    type="text"
    maxlength="200"
    autocomplete="off"
    enterkeyhint="search"
    placeholder={`${SITE.displayName} について検索`}
  />

  <button class="searchbox__submit" type="submit">検索</button>
</form>
