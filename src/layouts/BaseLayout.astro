---
import '../styles/global.css';
import { NAV, SITE } from '../consts';
import Prompt from '../components/Prompt.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  /** <title> と OGP に使うページタイトル */
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedAt,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '');
const isHome = pathname === '';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const feed = new URL('/rss.xml', Astro.site);

const pageTitle = isHome
  ? `${SITE.name} — ${SITE.displayName}`
  : `${title} · ${SITE.name}`;
const windowTitle = `${SITE.user}@web: ~${pathname}`;
const year = new Date().getFullYear();

const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0e0f" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={isHome ? pageTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} の更新情報`}
      href={feed.href}
    />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch {
          /* localStorage が使えない環境ではデフォルトのまま */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <div class="shell">
      <div class="titlebar">
        <div class="titlebar__dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <p class="titlebar__title">{windowTitle}</p>
        <ThemeToggle />
      </div>

      <div class="screen">
        <header>
          <Prompt cmd="ls" />
          <nav class="nav" aria-label="サイト内ナビゲーション">
            <a href="/" aria-label="ホーム" aria-current={isHome ? 'page' : undefined}>~/</a>
            {
              NAV.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.name}/
                </a>
              ))
            }
          </nav>
        </header>

        <main id="main">
          <slot />
        </main>

        <footer class="footer">
          <div class="prompt">
            <span class="prompt__path" aria-hidden="true">~/{SITE.user}</span>
            <span class="prompt__sigil" aria-hidden="true">$</span>
            <span class="cursor" aria-hidden="true"></span>
          </div>
          <div class="footer__links">
            <span># © {year} {SITE.displayName}</span>
            <a href="/rss.xml">rss</a>
            <a href="/sitemap-index.xml">sitemap</a>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
