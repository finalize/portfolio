---
import '../styles/global.css';
import { NAV, SITE } from '../consts';
import SearchBox from '../components/SearchBox.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  /** <title> と OGP に使うページタイトル */
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
  /**
   * hero = 検索窓を画面の中央に大きく出す（ホームで、まだ何も聞かれていないとき）。
   * results = 上に細く固定する。ホーム以外は常にこちら。
   * ホームでも `?q=` が付いていれば head のスクリプトが results に直す。
   */
  mode?: 'hero' | 'results';
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedAt,
  noindex = false,
  mode = 'results',
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '');
const isHome = pathname === '';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const feed = new URL('/rss.xml', Astro.site);

const pageTitle = isHome ? `${SITE.name} — ${SITE.displayName}` : `${title} · ${SITE.name}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.lang} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#202124" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={isHome ? pageTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} の更新情報`}
      href={feed.href}
    />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (() => {
        const root = document.documentElement;

        // 配色。保存された選択がいちばん強く、無ければ OS の設定、それも取れなければライト
        let theme = 'light';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
        } catch {
          /* localStorage が使えない環境ではライトのまま */
        }
        root.dataset.theme = theme;

        // `?q=` 付きで開かれたときは、hero を一瞬見せずに最初から results にする
        if (root.dataset.mode === 'hero' && new URLSearchParams(location.search).get('q')) {
          root.dataset.mode = 'results';
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <slot name="backdrop" />

    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href="/">{SITE.user}<span class="brand__dot">.</span>jp</a>
        <SearchBox />
        <slot name="under-search" />
      </div>
    </header>

    <main class="content" id="main">
      <div class="content__inner">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <span>© {year} {SITE.displayName}</span>
        {NAV.map((item) => <a href={`${item.href}/`}>{item.name}</a>)}
        <a href="/rss.xml">rss</a>
        <span class="footer__spacer"></span>
        <ThemeToggle />
      </div>
    </footer>
  </body>
</html>
