---
import BaseLayout from './BaseLayout.astro';
import { formatDate, type Post } from '../lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
---

<BaseLayout title={title} description={description} type="article" publishedAt={pubDate}>
  <article class="article">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>更新 {formatDate(updatedDate)}</span>}
        {draft && <span class="post-meta__draft">下書き</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="tags" style="margin-top:0.6rem">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={`/blog/tags/${tag}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <slot />
  </article>

  <a class="backlink" href="/blog/">← blog</a>
</BaseLayout>
