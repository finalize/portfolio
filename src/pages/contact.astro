---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIALS } from '../consts';
---

<BaseLayout title="Contact" description="お問い合わせ先（メール・SNS）。">
  <div class="stack-lg">
    <div>
      <h1 class="page-title">Contact</h1>
      <p class="page-lead">
        お仕事のご相談・ご質問はメールか SNS の DM へどうぞ。だいたい数日以内に返信します。
      </p>
    </div>

    <dl class="kv">
      {
        SOCIALS.map((social) => (
          <Fragment>
            <dt>{social.label}</dt>
            <dd>
              <a href={social.href} rel={social.label === 'mail' ? undefined : 'me'}>
                {social.value}
              </a>
            </dd>
          </Fragment>
        ))
      }
    </dl>
  </div>
</BaseLayout>
