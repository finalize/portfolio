---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, formatDate, getPosts } from '../../lib/content';

const posts = await getPosts();
const tags = collectTags(posts);
---

<BaseLayout title="Blog" description="開発中に調べたこと・作ったものについて書いた記事の一覧。">
  <div class="stack-lg">
    <div>
      <h1 class="page-title">Blog</h1>
      <p class="page-lead">
        開発中に調べたことと、作ったものの話。{posts.length} 件。更新は
        <a href="/rss.xml">RSS</a> で購読できます。
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p class="muted">まだ記事がありません。</p>
      ) : (
        <div class="results">
          {posts.map((post) => (
            <div class="result">
              <div class="result__meta">
                <span>/blog/{post.id}/</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              <a class="result__title" href={`/blog/${post.id}/`}>{post.data.title}</a>
              <p class="result__snippet">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="tags">
                  {post.data.tags.map((tag) => (
                    <li>
                      <a class="tag" href={`/blog/tags/${tag}/`}>{tag}</a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      )
    }

    {
      tags.length > 0 && (
        <div class="stack-md">
          <h2 class="page-title">タグ</h2>
          <ul class="tags">
            {tags.map(({ tag, count }) => (
              <li>
                <a class="tag" href={`/blog/tags/${tag}/`}>{tag}</a>
                <span class="muted tiny">{count}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</BaseLayout>
