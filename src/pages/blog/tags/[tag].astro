---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { collectTags, formatDate, getPosts } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`${tag} に関する記事の一覧。`}>
  <div class="stack-lg">
    <div>
      <h1 class="page-title">タグ: {tag}</h1>
      <p class="page-lead">{posts.length} 件。</p>
    </div>

    <div class="results">
      {
        posts.map((post) => (
          <div class="result">
            <div class="result__meta">
              <span>/blog/{post.id}/</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </div>
            <a class="result__title" href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="result__snippet">{post.data.description}</p>
          </div>
        ))
      }
    </div>
  </div>

  <a class="backlink" href="/blog/">← blog</a>
</BaseLayout>
