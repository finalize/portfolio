---
import BaseLayout from '../layouts/BaseLayout.astro';
import TermPic from '../components/TermPic.astro';
import { SITE } from '../consts';
---

<BaseLayout title="About" description={`${SITE.displayName}（${SITE.role}）のプロフィール。`}>
  {/* TODO: 経歴・興味・実績を本人の内容に差し替える */}
  <article class="article">
    <header class="post-header">
      <h1>{SITE.displayName}</h1>
      <p class="post-meta"><span>{SITE.role}</span></p>
    </header>

    <div class="avatar">
      <TermPic
        src="src/assets/avatar.jpeg"
        alt="愛犬のトイプードル。自作の termpic でマス目に落として描いたもの"
        mode="quadrant"
        cols={32}
        width={110}
      />
    </div>

    <p>{SITE.displayName} と申します。{SITE.role} として、Web とモバイルのプロダクトを個人で作っています。</p>

    <h2>いまやっていること</h2>
    <ul>
      <li>Cloudflare Workers（Hono / D1 / R2 / Durable Objects）でのバックエンド開発</li>
      <li>React / React Native (Expo) でのフロントエンド開発</li>
      <li>思いついたものを小さく作って公開するまでを一人で回すこと</li>
    </ul>

    <h2>よく使うもの</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>領域</th>
            <th>道具</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>言語</td>
            <td>TypeScript / SQL</td>
          </tr>
          <tr>
            <td>フロント</td>
            <td>React, Expo (React Native), Astro, Vite</td>
          </tr>
          <tr>
            <td>バックエンド</td>
            <td>Hono, tRPC, Drizzle ORM, Zod</td>
          </tr>
          <tr>
            <td>インフラ</td>
            <td>Cloudflare Workers / D1 / R2 / KV</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>これまで</h2>
    <ul>
      <li>2026 — TODO: 経歴を書く</li>
      <li>2025 — TODO: 経歴を書く</li>
    </ul>

    <p>
      作ったものは <a href="/works/">works</a>、書いたものは <a href="/blog/">blog</a> にあります。
      ご連絡は <a href="/contact/">contact</a> からどうぞ。
    </p>
  </article>
</BaseLayout>
