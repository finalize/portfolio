---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV } from '../consts';
---

<BaseLayout title="404 Not Found" description="ページが見つかりませんでした。" noindex>
  <div class="stack-lg">
    <div>
      <h1 class="page-title">
        <span class="notfound-path" data-404-path>このページ</span> は見つかりませんでした
      </h1>
      <p class="page-lead">URL が変わったか、もともと存在しないページです。</p>
    </div>

    <div class="stack-md">
      <p class="muted">上の検索窓から、知りたいことを聞けます。</p>
      <div class="chips">
        {NAV.map((item) => <a class="chip" href={`${item.href}/`}>{item.name}</a>)}
      </div>
    </div>
  </div>

  <script is:inline>
    const target = document.querySelector('[data-404-path]');
    if (target) target.textContent = location.pathname;
  </script>
</BaseLayout>
