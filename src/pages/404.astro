---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/Prompt.astro';
---

<BaseLayout title="404 Not Found" description="ページが見つかりませんでした。" noindex>
  <Prompt cmd="cat ." />
  <div class="output">
    <h1 class="error-line">
      <span aria-hidden="true">zsh: no such file or directory: </span>
      <span data-404-path>/</span>
    </h1>
    <p class="muted">URL が変わったか、もともと存在しないページです。</p>
    <ul class="nav">
      <li><a href="/">~/</a></li>
      <li><a href="/blog/">blog/</a></li>
      <li><a href="/works/">works/</a></li>
    </ul>
  </div>

  <script is:inline>
    const target = document.querySelector('[data-404-path]');
    if (target) target.textContent = location.pathname;
  </script>

  <style>
    .error-line {
      color: var(--danger);
      font-weight: 400;
      overflow-wrap: anywhere;
    }
  </style>
</BaseLayout>
