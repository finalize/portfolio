---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/Prompt.astro';
import { SITE, SOCIALS } from '../consts';
import { formatDate, getPosts, getWorks } from '../lib/content';

const posts = (await getPosts()).slice(0, 5);
const works = (await getWorks()).slice(0, 3);
---

<BaseLayout title={SITE.name}>
  <Prompt cmd="whoami" />
  <section class="output">
    <h1 class="hero">
      {SITE.displayName}
      <span class="hero__role muted">— {SITE.role}</span>
    </h1>
    {/* TODO: 自己紹介を本人の言葉に差し替える */}
    <p>Cloudflare Workers と TypeScript で、個人開発のプロダクトを作っています。最近は Hono + D1 + Expo の組み合わせが多めです。</p>
    <p class="muted">このサイトには、作ったものと開発中に調べたことを置いています。</p>
  </section>

  <Prompt cmd="ls works/" />
  <section class="output">
    <h2 class="comment">最近つくったもの</h2>
    {
      works.length === 0 ? (
        <p class="muted">まだ何もありません。</p>
      ) : (
        <ul class="filelist">
          {works.map((work) => (
            <li class="filerow">
              <span class="filerow__meta">{work.data.year}</span>
              <div>
                <a class="filerow__name" href={`/works/${work.id}/`}>{work.data.title}</a>
                <span class="filerow__desc">{work.data.summary}</span>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <p class="tiny"><a href="/works/">→ works/ をすべて見る</a></p>
  </section>

  <Prompt cmd="ls -t blog/ | head -5" />
  <section class="output">
    <h2 class="comment">最近書いたもの</h2>
    {
      posts.length === 0 ? (
        <p class="muted">まだ記事がありません。</p>
      ) : (
        <ul class="filelist">
          {posts.map((post) => (
            <li class="filerow">
              <time class="filerow__meta" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <div>
                <a class="filerow__name" href={`/blog/${post.id}/`}>{post.data.title}</a>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <p class="tiny"><a href="/blog/">→ blog/ をすべて見る</a></p>
  </section>

  <Prompt cmd="cat contact.txt" />
  <section class="output">
    <dl class="kv">
      {
        SOCIALS.map((social) => (
          <Fragment>
            <dt>{social.label}</dt>
            <dd><a href={social.href}>{social.value}</a></dd>
          </Fragment>
        ))
      }
    </dl>
  </section>
</BaseLayout>
