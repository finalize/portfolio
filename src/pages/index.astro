---
import BaseLayout from '../layouts/BaseLayout.astro';
import Answer from '../components/Answer.astro';
import { SITE } from '../consts';

/** 最初に出す例。事実集合で確実に答えられるものを選んである */
const EXAMPLES = [
  '何を作ってきた人？',
  'Cloudflare Workers の経験は？',
  'Go は書ける？',
  '連絡先を教えて',
];
---

<BaseLayout title={SITE.name} mode="hero">
  <div class="hero-extras" slot="under-search">
    <div class="chips">
      {EXAMPLES.map((example) => <button class="chip" type="button" data-q={example}>{example}</button>)}
    </div>
    <p class="hero-note">
      作ったものと、開発中に調べたことについて答える。
      <a href="/works/">works</a> と <a href="/blog/">blog</a> は直接も読める。
    </p>
    <noscript>
      <p class="hero-note">
        検索には JavaScript が要る。<a href="/works/">works</a> ・
        <a href="/blog/">blog</a> ・ <a href="/about/">about</a> はそのまま読める。
      </p>
    </noscript>
  </div>

  <Answer />
</BaseLayout>
