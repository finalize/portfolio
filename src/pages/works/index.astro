---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorks } from '../../lib/content';

const works = await getWorks();
---

<BaseLayout title="Works" description="これまでに作ったプロダクト・ツールの一覧。">
  <div class="stack-lg">
    <div>
      <h1 class="page-title">Works</h1>
      <p class="page-lead">作ったプロダクトとツール。{works.length} 件。</p>
    </div>

    {
      works.length === 0 ? (
        <p class="muted">まだ何もありません。</p>
      ) : (
        <div class="results">
          {works.map((work) => (
            <div class="result">
              <div class="result__meta">
                <span>/works/{work.id}/</span>
                <span>{work.data.year}</span>
              </div>
              <a class="result__title" href={`/works/${work.id}/`}>{work.data.title}</a>
              <p class="result__snippet">{work.data.summary}</p>
              {work.data.stack.length > 0 && (
                <ul class="stack-list">
                  {work.data.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
